# 5SIM API (untuk verifikasi telepon virtual)
# Dapatkan API key di https://5sim.net
# Opsional: jika kosong, tool hanya akan mengandalkan tombol Skip.
FIVESTIM_API_KEY=your_api_key_here
FIVESTIM_COUNTRY=indonesia
FIVESTIM_OPERATOR=any
FIVESTIM_PRODUCT=google
SMS_TIMEOUT=120

# PROXY
# Set true untuk mengaktifkan proxy gratis dari FreeProxy
USE_PROXY=false
# Proxy manual (opsional). Format: host:port atau user:pass@host:port
MANUAL_PROXY=

# BROWSER
# Headless mode (tanpa jendela browser)
HEADLESS=false
# Aktifkan anti-detection (stealth JS, dll)
ANTI_DETECTION=true
# Biarkan browser terbuka setelah akun selesai (untuk debugging)
# false = langsung tutup (cocok untuk bulk mode)
KEEP_BROWSER_OPEN=false

# SESSION WARMING
# Jumlah halaman acak yang dikunjungi sebelum pendaftaran
WARMUP_PAGES=3
